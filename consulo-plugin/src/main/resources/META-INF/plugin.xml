<consulo-plugin url="https://github.com/consulo/consulo-bazel">
    <id>consulo.bazel</id>
    <name>Bazel</name>
    <version>SNAPSHOT</version>
    <vendor>consulo.io</vendor>
    <!-- Java/Kotlin/Scala import: the optional library consulo.bazel.java (consulo-bazel-java) -->
    <depends optional="true">consulo.java</depends>
    <description>Bazel support: Starlark, .bazelrc, Bazel query and .bazelversion languages. Based on the JetBrains Bazel plugin (hirschgarten).</description>
    <tags>
        <tag>custom.language</tag>
    </tags>
</consulo-plugin>

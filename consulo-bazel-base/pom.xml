    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.bazel.base</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!--
      One Java module for the upstream core modules: they share packages (split packages are not allowed in JPMS),
      so their upstream source folders are compiled together here. Consulo-only code and resources live in
      src/main. See CONSULO.md.
    -->
    <build>
        <plugins>
            <!-- consulo: upstream core resources read by the ported code (Starlark signatures, inspection descriptions).
                 Copied instead of declared as a <resource>: maven-consulo-plugin's generate-icon stops at the first resource
                 directory without ICON-LIB -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>upstream-core-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../intellij.bazel.core/resources</directory>
                                    <includes>
                                        <include>bazelSignatures/**</include>
                                        <include>inspectionDescriptions/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>-Xmaxerrs</arg>
                        <arg>5000</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>upstream-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../intellij.bazel.languages/src</source>
                                <source>${project.basedir}/../intellij.bazel.commons/src</source>
                                <source>${project.basedir}/../intellij.bazel.projectview/src</source>
                                <source>${project.basedir}/../intellij.bazel.backend/src</source>
                                <source>${project.basedir}/../intellij.bazel.core/src</source>
                                <source>${project.basedir}/../intellij.bazel.bazelisk/src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>gen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-icon</goal>
                            <goal>generate-localize</goal>
                            <goal>generate-lexers</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- build cache input: the upstream core resources copied by maven-resources-plugin -->
        <maven.build.cache.input.1>../intellij.bazel.core/resources</maven.build.cache.input.1>
    </properties>

